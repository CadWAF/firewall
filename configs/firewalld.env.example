FIREWALL_API_TOKEN=change-me-to-a-long-random-string
FIREWALL_CONFIG_DIR=/etc/firewall
FIREWALL_LISTEN_ADDR=127.0.0.1:9090
FIREWALL_IFACE=eth0

# Diagnostic logging (for troubleshooting 24h outages)
# File + journalctl; grep: journalctl -u firewalld | grep fw-diag
FIREWALL_DIAG_LOG=/var/log/firewalld-diag.log
FIREWALL_DIAG_INTERVAL=15m
# Set FIREWALL_DIAG_LOG=off to disable file logging
