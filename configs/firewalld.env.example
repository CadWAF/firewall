FIREWALL_API_TOKEN=change-me-to-a-long-random-string
FIREWALL_CONFIG_DIR=/etc/firewall
FIREWALL_LISTEN_ADDR=127.0.0.1:9090
FIREWALL_IFACE=eth0

# Diagnostic logging (for troubleshooting 24h outages)
# File + journalctl; grep: journalctl -u firewalld | grep fw-diag
FIREWALL_DIAG_LOG=/var/log/firewalld-diag.log
FIREWALL_DIAG_INTERVAL=15m
# Set FIREWALL_DIAG_LOG=off to disable file logging

# Re-apply allow/deny/ports into live BPF maps without detaching XDP/TC.
# Default 12h. Use "off" or "0" to disable; also runs on map-integrity alerts.
FIREWALL_MAP_REFRESH_INTERVAL=12h

# Refused sources are recorded to a local SQLite file and served from
# GET /api/v1/drops, so "which addresses, and why" has an answer after the
# fact — the packet counters can only say how many.
#
# Set to "off" on a node with no disk to spare; filtering is unaffected.
FIREWALL_DROP_LOG=/var/lib/firewall/drops.sqlite

# How long an address stays on record after it goes quiet.
FIREWALL_DROP_RETENTION=336h
